# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fichiers évocateurs d'agents IA, regénérés par create-next-app si re-bootstrap
AGENTS.md
# CLAUDE.md : SUIVI par git (protocole doc partagé Mac/PC) — volontairement pas ignoré

# Vraies donn�es seed (RGPD : jamais commit)
data/seed/local/

# Triage reel du cockpit Mes emails (PII coproprietaires, produit par assistant-ia)
data/mes-emails-triage.json

# Tout JSON depose a la racine de data/ = exports Crypto / PII coproprietaires
# (identites, emails, lots...) -> jamais commit. Les samples vont dans data/samples/.
data/*.json

# Exports PowerApps : binaires lourds / re-exportables (on garde les flux JSON + le guide)
docs/powerapps/*.zip
docs/powerapps/**/*.msapp

# Classeurs Excel de travail (sources, pas versionnes ; ~$ = lock Office)
*.xlsx
~$*.xlsx
