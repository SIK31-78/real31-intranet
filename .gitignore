# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# fichiers évocateurs d'agents IA, regénérés par create-next-app si re-bootstrap
AGENTS.md
# CLAUDE.md : SUIVI par git (protocole doc partagé Mac/PC) — volontairement pas ignoré

# Vraies donn�es seed (RGPD : jamais commit)
data/seed/local/

# Triage reel du cockpit Mes emails (PII coproprietaires, produit par assistant-ia)
data/mes-emails-triage.json

# Tout export depose dans data/ (racine ET sous-dossiers) = Crypto / PII coproprietaires
# (identites, emails, mandats, lots...) -> JAMAIS commit. Regle RECURSIVE : l'audit pre-prod
# 2026-07-06 a montre que data/*.csv (non recursif) laissait passer data/Export crypto/*.csv.
# Les samples anonymises vont dans data/samples/ (a re-autoriser explicitement si besoin).
data/**/*.json
data/**/*.txt
data/**/*.csv
data/**/*.pdf
data/**/*.doc
data/**/*.docx
data/**/*.sql
data/**/*.md
data/*.json
data/*.txt
data/*.csv
data/*.sql
data/*.md
# RE-AUTORISATION EXPLICITE (annoncee plus haut) : data/samples/ = fixtures ANONYMISEES,
# l'etage COMMITE du test de regression (etape 0 extraction, cf.
# docs/etude-indexation-extraction-patrimoine.md §5). PSEUDONYMES VERIFIES avant commit
# (2026-07-30 : purge d'une table de re-identification via owner_ref_temp). Les PDF et
# tout le reste de data/ restent exclus - on ne re-autorise QUE json et md, jamais *.
!data/samples/**/*.json
!data/samples/**/*.md

# Exports PowerApps : binaires lourds / re-exportables (on garde les flux JSON + le guide)
docs/powerapps/*.zip
docs/powerapps/**/*.msapp

# Classeurs Excel de travail (sources, pas versionnes ; ~$ = lock Office)
*.xlsx
~$*.xlsx

# Outillage local / agents (regenere par machine, jamais commit)
# .claude : local (settings.local.json = par machine), SAUF les skills projet
# qui se synchronisent entre les postes via le repo.
.claude/*
!.claude/skills/
.agents/
skills-lock.json

# Schema eStale complet (13 Mo, dump volumineux) : garde le .graphql + le -summary.md
# lisibles, mais pas le JSON brut. A retirer de l'index : git rm --cached docs/estale-schema.json
docs/estale-schema.json

# Gabarits / assets metier binaires deposes dans docs/ (sources non versionnees ->
# ranges dans data/gabarits et data/assets). On garde les .md, .html (mockups refonte-ui),
# .graphql lisibles ; on ignore les binaires bureautiques et images.
docs/**/*.doc
docs/**/*.docx
docs/**/*.dotx
docs/**/*.pdf
docs/**/*.png
docs/**/*.jpg

# Modeles de langue telecharges par tesseract.js au premier appel (chemin de cache par
# defaut = cwd). ~1 a 5 Mo par langue, regenerables : ils n'ont rien a faire dans le repo.
*.traineddata
*.traineddata.gz
