# Template des variables d'environnement.
# Copier en .env.local et remplir avec les valeurs reelles.
# .env.local n'est pas commite (cf. .gitignore).

# Supabase (cf. Settings > API et Settings > Database)
# Region recommandee : EU Frankfurt (eu-central-1) pour conformite RGPD.

# URL publique du projet (https://xxxxxxxxxxx.supabase.co).
# Faible sensibilite (deja public dans le bundle JS cote client).
NEXT_PUBLIC_SUPABASE_URL=

# Cle "anon" (publique). Faible sensibilite, protegee par RLS.
# Cle utilisee depuis le navigateur et les Server Components.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle "service_role" (privee). CRITIQUE : bypass toutes les RLS.
# Utilisee uniquement cote serveur (jobs cron, scripts admin, codegen types).
# Ne JAMAIS l'exposer dans le bundle client.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string directe (port 5432, pas le pooler 6543).
# Utilisee par le CLI Supabase pour les migrations.
# Contient le mot de passe Postgres en clair. CRITIQUE.
SUPABASE_DB_URL=

# Slug du projet (les caracteres avant .supabase.co dans l'URL).
# Utilise par `supabase link --project-ref <ici>`.
# Faible sensibilite mais permet d'identifier le projet.
SUPABASE_PROJECT_REF=

# Source du referentiel copros (liste + fiche).
#   "supabase" -> lit la vraie data public.Copropriete (App A), lecture seule.
#   absent / autre -> donnees mockees (defaut).
# Necessite NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY de la base cible.
COPRO_SOURCE=

# Base URL du deep-link eStale (bouton "Ouvrir dans eStale" sur les copros eStale).
ESTALE_DEEPLINK_BASE=
