# Template des variables d'environnement.
# Copier en .env.local et remplir avec les valeurs reelles.
# .env.local n'est pas commite (cf. .gitignore).

# Supabase (cf. Settings > API et Settings > Database)
# Region recommandee : EU Frankfurt (eu-central-1) pour conformite RGPD.

# URL publique du projet (https://xxxxxxxxxxx.supabase.co).
# Faible sensibilite (deja public dans le bundle JS cote client).
NEXT_PUBLIC_SUPABASE_URL=

# Cle "anon" (publique). Faible sensibilite, protegee par RLS.
# Cle utilisee depuis le navigateur et les Server Components.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle "service_role" (privee). CRITIQUE : bypass toutes les RLS.
# Utilisee uniquement cote serveur (jobs cron, scripts admin, codegen types).
# Ne JAMAIS l'exposer dans le bundle client.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string directe (port 5432, pas le pooler 6543).
# Utilisee par le CLI Supabase pour les migrations.
# Contient le mot de passe Postgres en clair. CRITIQUE.
SUPABASE_DB_URL=

# Slug du projet (les caracteres avant .supabase.co dans l'URL).
# Utilise par `supabase link --project-ref <ici>`.
# Faible sensibilite mais permet d'identifier le projet.
SUPABASE_PROJECT_REF=

# Source du referentiel copros (liste + fiche).
#   "supabase" -> lit la vraie data public.Copropriete (App A), lecture seule.
#   absent / autre -> donnees mockees (defaut).
# Necessite NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY de la base cible.
COPRO_SOURCE=

# Base URL du deep-link eStale (bouton "Ouvrir dans eStale" sur les copros eStale).
ESTALE_DEEPLINK_BASE=

# Mot de passe du gate d'acces global (Basic Auth, avant la vraie auth Entra ID).
# Defaut "real31" si non defini. Le nom d'utilisateur est ignore.
SITE_PASSWORD=

# Integration eStale (Phase B, ADR-022) : compte de service (cookie de session).
# Login POST {base}/api/login, GraphQL {base}/graphql/intranet.
ESTALE_BASE_URL=https://api.estale.app
ESTALE_EMAIL=
ESTALE_PASSWORD=
# Plus tard (Phase C) : cle API Bearer, prioritaire sur le cookie quand presente.
# ESTALE_API_KEY=

# SSO Microsoft Entra ID (Auth.js v5). Cf. docs/entra-app-registration.md.
# Memes noms que le projet App A du patron (convention Auth.js par defaut).
# Si l'un des trois AUTH_MICROSOFT_ENTRA_ID_* manque -> l'app retombe sur dev-login (pas de SSO).
#
# ID client (Application ID) de l'App Registration Entra.
AUTH_MICROSOFT_ENTRA_ID_ID=
# Secret client genere dans Azure (Certificats et secrets).
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Issuer = https://login.microsoftonline.com/<TENANT_ID>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Secret de chiffrement des sessions Auth.js. Generer : npx auth secret (ou openssl rand -base64 32).
AUTH_SECRET=
# URL de base de l'app (dev). Notre app tourne sur le port 3000.
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ROLES (allowlists d'emails, CSV) - LE modele est documente dans src/lib/auth/roles.ts
# ---------------------------------------------------------------------------
# Le role par defaut est `gestionnaire` : tout collaborateur authentifie l'a, sans allowlist.
# Les autres roles se posent ici (et sur Vercel, scope Production). Variable absente = personne
# n'a le role. La forme PLURIELLE est la forme recommandee ; le singulier (DIRECTEUR=, MANAGER=,
# COMPTABLE=, SUPER_ADMIN=) est aussi accepte, et les deux se cumulent.
#
# Directeurs : ADMIN du module reprise (creer/analyser/corriger/injecter/fiches/mapping/archiver).
DIRECTEURS=
# Managers : memes droits que les directeurs sur la reprise.
MANAGERS=
# Pole comptable : acces au dashboard /comptabilite (toutes les copros, hors portefeuille).
COMPTABLES=
# Super-admins : admin technique. Porte TOUS les roles + peut changer de gestionnaire (dev-login).
SUPER_ADMINS=

# ---------------------------------------------------------------------------
# FACTURATION (Pennylane)
# ---------------------------------------------------------------------------
# Jeton d'API Pennylane (API externe v2), utilise pour creer les factures
# BROUILLON des honoraires syndic. Variable absente = adapter no-op : le parcours
# de facturation reste deroulable, mais rien n'est envoye a Pennylane.
# NE JAMAIS stocker ce jeton en base (le legacy PowerApps le gardait en clair
# dans la liste SharePoint « Parametres »).
PENNYLANE_API_KEY=
