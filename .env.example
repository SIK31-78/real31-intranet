# Credentials Supabase - projet mutualise du patron, schema real31_intranet.
# Recuperer ces valeurs depuis le Dashboard Supabase (Settings > API).
# Cf. docs/supabase-setup.md pour la procedure complete.

# URL du projet, format https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Cle publique anon (visible cote browser, la RLS protege les acces).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle service_role - SECRET, bypass la RLS.
# A n'utiliser QUE cote serveur (jobs cron, scripts admin, health check).
# Ne JAMAIS prefixer NEXT_PUBLIC_ pour eviter toute fuite vers le client.
SUPABASE_SERVICE_ROLE_KEY=

# Tri des e-mails, bouton « Transférer » (REA-500) : on = le transfert à un collègue REAL31
# part directement depuis la boîte partagée triée, même si l'envoi n'y est pas ouvert
# (MAIL_ENVOI / « envoi » de MAIL_TRI_BOITES). Absent ou autre valeur = coupé : le transfert
# reste en brouillon dans Outlook (sauf envoi ouvert sur la boîte) et le mail reste dans la file.
# MAIL_TRI_TRANSFERT=on
